{
  "name": "Jencut Precision",
  "version": "1.0",
  "referenceViewport": {
    "width": 1440,
    "height": 900
  },
  "typography": {
    "display": {
      "family": "Manrope",
      "weights": [
        600,
        700
      ]
    },
    "ui": {
      "family": "Inter",
      "weights": [
        400,
        600
      ],
      "numeric": "tabular-nums"
    },
    "sizesPx": {
      "caption": 12,
      "body": 14,
      "form": 16,
      "section": 18,
      "pageTitle": 32
    }
  },
  "color": {
    "dark": {
      "canvas": "#101114",
      "panel": "#191B20",
      "raised": "#242730",
      "border": "#373A45",
      "text": "#F4F4F5",
      "muted": "#A1A1AA",
      "accent": "#A78BFA",
      "primary": "#6D28D9",
      "onPrimary": "#FFFFFF",
      "focus": "#C4B5FD"
    },
    "light": {
      "canvas": "#F5F4F8",
      "panel": "#FFFFFF",
      "raised": "#EEEAF4",
      "border": "#D6D0E0",
      "text": "#181923",
      "muted": "#5F596B",
      "accent": "#7C3AED",
      "primary": "#6D28D9",
      "onPrimary": "#FFFFFF",
      "focus": "#6D28D9"
    },
    "tracks": {
      "video": "#443957",
      "title": "#5D4A82",
      "audio": "#23364F",
      "audioWave": "#8AB4ED",
      "music": "#203B36",
      "musicWave": "#7DD3B0"
    },
    "semantic": {
      "success": "#7DD3B0",
      "warning": "#F4C878",
      "error": "#F38B98"
    }
  },
  "spacingPx": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "radiusPx": {
    "clip": 4,
    "control": 6,
    "panel": 8,
    "dialog": 10
  },
  "layoutPx": {
    "header": 60,
    "rail": 52,
    "library": 260,
    "inspector": 300,
    "timelineInitial": 300,
    "desktopMinWidth": 1280,
    "desktopMinHeight": 720
  },
  "motion": {
    "fastMs": 120,
    "normalMs": 180,
    "respectReducedMotion": true
  },
  "validation": "Valores de diseño; contraste, foco y adaptación se auditan al implementar."
}
