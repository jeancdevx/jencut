{
  "name": "jencut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs start",
    "dev:stop": "node scripts/dev.mjs stop",
    "dev:status": "node scripts/dev.mjs status",
    "dev:logs": "node scripts/dev.mjs logs",
    "build": "astro build",
    "preview": "node scripts/dev.mjs preview",
    "check": "tsc --noEmit && astro check",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "pnpm lint --fix",
    "format": "pnpm lint:fix && oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "tsx --test tests/domain.test.ts tests/service.test.ts",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm format:check && pnpm check && pnpm test && pnpm build",
    "fixtures:verify": "node scripts/fixtures.mjs",
    "prepare": "husky",
    "commitlint": "commitlint",
    "astro": "astro",
    "service": "tsx src/service/index.ts",
    "dev:web": "astro dev --background --host 127.0.0.1",
    "preview:stop": "astro preview stop",
    "preview:status": "astro preview status",
    "preview:logs": "astro preview logs",
    "evidence": "node scripts/collect-evidence.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.8",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "ajv": "8.20.0",
    "astro": "7.4.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fastify": "5.12.7",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.3",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.22.2",
    "pnpm": "10.33.2"
  },
  "packageManager": "pnpm@10.33.2"
}
